# Copy to .env and fill in. Never commit .env.
# All providers below have free tiers; total model spend for this project is $0.

# --- Model providers (free tiers) ---
# Google AI Studio key: frontier eval model + LLM judge (OpenAI-compatible endpoint).
GEMINI_API_KEY=
# Judge model (default gemini-3.1-flash-lite: its own free quota, separate from both eval models).
# PAYGYM_JUDGE_MODEL=gemini-3.1-flash-lite
# Groq key: large open-weight eval model.
GROQ_API_KEY=

# --- Sandbox ---
# Secret used to derive generator seeds from public seeds (HMAC) and to sign run tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SANDBOX_SECRET=
# Upstash Redis (free tier, via Vercel Marketplace). Local dev uses the compose `redis` service instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional ---
# Only needed to publish the trained LoRA adapter to the Hugging Face Hub.
HF_TOKEN=
